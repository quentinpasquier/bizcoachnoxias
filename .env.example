# Supabase (https://supabase.com → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service-role (INDISPENSABLE pour le back-office /admin)
# À garder strictement côté serveur, ne jamais exposer.
# Project Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Anthropic Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (optionnel mais recommandé)
# Sert à deux choses : TTS haute qualité (voix prospect réaliste) ET STT
# Whisper (transcription du commercial pendant l'appel, plus précis que le
# Web Speech du navigateur pour le vocabulaire métier B2B). Sans clé, fallback
# automatique sur les API natives du navigateur.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
